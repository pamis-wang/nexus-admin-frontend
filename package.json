{
  "name": "nexus-admin-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "predev": "node scripts/ensure-node-version.mjs && node scripts/setup-git-hooks.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-node-version.mjs && node scripts/setup-git-hooks.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "verify": "run-s verify:format verify:oxlint verify:eslint verify:types verify:test verify:build",
    "verify:format": "oxfmt --check src/",
    "verify:oxlint": "oxlint . --deny-warnings",
    "verify:eslint": "eslint . --max-warnings 0",
    "verify:types": "vue-tsc --build --force",
    "verify:test": "vitest run",
    "verify:build": "vite build",
    "verify:quick": "run-s verify:format verify:oxlint"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.2",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "pinia": "^4.0.2",
    "quasar": "^2.23.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@quasar/vite-plugin": "^1.12.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.2.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.80.0",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-vue": "~10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.59.0",
    "oxlint": "~1.80.0",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^24.16.0"
  }
}
