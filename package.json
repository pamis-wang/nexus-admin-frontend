{
  "name": "nexus-admin-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node scripts/setup-git-hooks.mjs",
    "predev": "node scripts/ensure-node-version.mjs && node scripts/setup-git-hooks.mjs",
    "dev": "vite",
    "prebuild": "node scripts/ensure-node-version.mjs && node scripts/setup-git-hooks.mjs",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:tour": "playwright test tour-anchors --project=chromium",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "oxfmt src/",
    "verify": "run-s verify:format verify:oxlint verify:eslint verify:types verify:build",
    "verify:format": "oxfmt --check src/",
    "verify:oxlint": "oxlint . --deny-warnings",
    "verify:eslint": "eslint . --cache --max-warnings 0",
    "verify:types": "vue-tsc --build --force",
    "verify:test": "vitest run",
    "verify:build": "vite build",
    "verify:quick": "run-s verify:format verify:oxlint"
  },
  "dependencies": {
    "@quasar/extras": "2.0.4",
    "@vueuse/core": "14.4.0",
    "axios": "1.20.0",
    "driver.js": "1.8.0",
    "pinia": "4.0.3",
    "quasar": "2.27.0",
    "vue": "3.5.41",
    "vue-draggable-plus": "0.6.1",
    "vue-i18n": "11.4.10",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@playwright/test": "1.63.0",
    "@quasar/vite-plugin": "2.0.2",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.80.0",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-vue": "10.10.0",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "sass-embedded": "1.103.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "5.0.0",
    "vue-tsc": "3.3.11"
  },
  "engines": {
    "node": "^24.22.1"
  }
}
