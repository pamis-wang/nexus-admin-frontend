{
  "extends": "./tsconfig.app.json",

  // 只收測試檔並清掉排除設定；測試裡 import 的應用程式碼會由模組解析自動帶入。
  // 全域型別宣告例外：它們不被任何檔案 import，沒列進來的話，
  // 被連帶拉進檢查的頁面就會找不到 ErrorResponseStructure 這類全域型別。
  "include": ["src/__tests__/**/*", "src/global.d.ts", "src/components.d.ts", "env.d.ts"],
  "exclude": [],

  "compilerOptions": {
    // Vitest 跑在與應用程式不同的環境，lib 與 types 要跟著換
    "lib": [],
    "types": ["node", "jsdom"],

    // `vue-tsc --build` 會產生 .tsbuildinfo，指定位置避免落在根目錄
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo"
  }
}
